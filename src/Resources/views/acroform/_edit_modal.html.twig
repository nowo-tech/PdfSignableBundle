{#
  AcroForm edit-field modal (REQ-UI-001): native <dialog> opened by the editor JS with showModal(); regions header /
  content / actions (nowo-ui-modal__*) are in _edit_modal_body.html.twig. Bootstrap classes (modal-content, modal-header,
  …) are kept for host styling only. Override via templates/bundles/NowoPdfSignableBundle/acroform/_edit_modal.html.twig.
  Must be rendered inside #acroform-editor-root.
#}
{% block acroform_edit_modal %}
<dialog class="nowo-ui-modal acroform-edit-modal" id="acroform-edit-modal" aria-labelledby="acroform-edit-modal-title">
  <div class="nowo-ui-modal__panel modal-content">
    {{ include('@NowoPdfSignableBundle/acroform/_edit_modal_body.html.twig', {config: acroform_config|default({}), acroform_edit_form: acroform_edit_form|default(null)}) }}
  </div>
</dialog>
{% endblock %}
