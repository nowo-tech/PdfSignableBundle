{#
  AcroForm edit-field modal body. Override via templates/bundles/NowoPdfSignableBundle/acroform/_edit_modal_body.html.twig.
  Renders acroform_edit_form (FormView from AcroFormFieldEditType) or, when omitted, the same form built from config by
  nowo_pdf_signable_acroform_edit_form(). Required IDs: acroform-edit-modal-title, acroform-edit-field-id,
  acroform-edit-field-name or acroform-edit-field-name-select (and acroform-edit-field-name-other if field_name_other_text set),
  acroform-edit-control-type, acroform-edit-rect (if show_field_rect), acroform-edit-max-len, acroform-edit-hidden,
  acroform-edit-create-if-missing, acroform-edit-options, acroform-edit-default-value, acroform-edit-default-checked,
  acroform-edit-checkbox-value-on/off, acroform-edit-checkbox-icon, acroform-edit-font-size, acroform-edit-font-family,
  acroform-edit-font-auto-size, acroform-edit-cancel, acroform-edit-save.
#}
{% block acroform_edit_modal_body %}
<div class="modal-header py-2">
  <h6 class="modal-title" id="acroform-edit-modal-title">{{ 'acroform_editor.modal_edit_title'|trans({}, 'NowoPdfSignableBundle') }}</h6>
  <button type="button" class="btn-close btn-close-sm" id="acroform-edit-close" aria-label="{{ 'acroform_editor.modal_cancel'|trans({}, 'NowoPdfSignableBundle') }}"></button>
</div>
<div class="modal-body">
{# REQ-TWIG-005: always a Symfony Form (AcroFormFieldEditType, acroform-edit-* ids for the JS). Without acroform_edit_form,
   the form is built from config. Children are rendered without form_start/form_end because this modal sits inside the
   editor widget of the host page form (a nested form element is invalid HTML); the editor JS reads the fields by id. #}
{% set _edit_form = acroform_edit_form ?? nowo_pdf_signable_acroform_edit_form(config ?? {}) %}
{% form_theme _edit_form '@NowoPdfSignableBundle/form/theme.html.twig' %}
<div id="acroform-edit-form" class="acroform-edit-form">
  {# required: false — the modal is filled by JS and must never block the submit of the surrounding page form. #}
  {% for child in _edit_form %}
    {% if not child.rendered %}
      {{ form_row(child, {required: false}) }}
    {% endif %}
  {% endfor %}
</div>
</div>
<div class="modal-footer py-2">
  <button type="button" class="btn btn-sm btn-outline-secondary" id="acroform-edit-cancel">{{ 'acroform_editor.modal_cancel'|trans({}, 'NowoPdfSignableBundle') }}</button>
  <button type="button" class="btn btn-sm btn-primary" id="acroform-edit-save">{{ 'acroform_editor.modal_save'|trans({}, 'NowoPdfSignableBundle') }}</button>
</div>
{% endblock %}
