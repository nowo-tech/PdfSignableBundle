# PHPStan configuration for PdfSignable Bundle
# Compatible with PHP 8.2+ and Symfony 7.x / 8.x

includes:
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon

parameters:
    level: 8
    treatPhpDocTypesAsCertain: false
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
    reportUnmatchedIgnoredErrors: true
    # REQ-CS-006: keep ignoreErrors empty — fix findings instead of silencing
    ignoreErrors: []
