{
	order mercure after encode
	# Timeout hierarchy (REQ-RUNTIME-001): bundle http_timeout 30 s / process_timeout 60 s /
	# process_script_timeout 120 s < PHP max_execution_time 150 s < Caddy write timeout 180 s.
	servers {
		timeouts {
			write 180s
		}
	}
	frankenphp {
		php_ini max_execution_time 150
		php_ini max_input_time 150
		max_wait_time 30s
	}
	skip_install_trust
}

:443 {
	tls internal
	root * /app/public
	encode zstd br gzip
	# Disable cache in development so changes are reflected immediately
	header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
	header Pragma "no-cache"
	# Classic mode (no worker): each request runs in a new PHP process so the app always responds and file changes are visible
	mercure {
		anonymous
	}

	php_server {
		hot_reload
	}
}
